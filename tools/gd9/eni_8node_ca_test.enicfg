# hand-written GD9.3 test config (C-03/C-04), NOT generated from an ENI:
# eni_8node_dc_sdo.enicfg + Complete Access PDO assign (0x1C12/0x1C13, PS) on
# every slave + a 16 byte normal download (0x8002) on slave 1. Replaced by
# the TwinCAT eni_8node_ca.xml -> .enicfg in step 9.4.
enicfg 1
source eni_8node_dc_sdo.xml sha256 1d29b75c6356ecb8d5d819c12e29914acfd19bd8d45511daf00eb99a61c1bbbc
cycle_us 1000
