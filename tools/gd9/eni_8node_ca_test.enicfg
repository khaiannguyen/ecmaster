slave 2 name "Box 2 (SOFTBUS-PD4)" vendor 0x499 product 0x1 rev 0x1 check_rev 1 addr 0x03EA osize_bits 32 isize_bits 32 dc 1 refclock 0 sync0_ns 1000000 sync1_ns 0 shift_ns 0 assign 0x0300
