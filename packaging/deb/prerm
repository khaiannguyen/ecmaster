# ecmaster prerm (Phase 12.3): masters stopped (SIGTERM = S6 walk-down) before
# their binary goes; on remove (not upgrade) every instance is disabled and
# the EtherCAT ports get their saved settings back (ecmaster-net@ stop).
set -e
[ -d /run/systemd/system ] || exit 0
inst () {
    { systemctl list-units --all --plain --no-legend "$1@*" 2>/dev/null | awk '{print $1}'
      systemctl list-unit-files --plain --no-legend "$1@*" 2>/dev/null | awk '{print $1}'
      ls /etc/systemd/system/*.wants/ 2>/dev/null; } | grep "^$1@..*\.service$" | sort -u
}
case "$1" in
remove|deconfigure)
    for t in ecm_run ecmaster-clock ecmaster-net; do
        for u in $(inst $t); do systemctl disable --now "$u" >/dev/null 2>&1 || true; done
    done ;;
upgrade)
    for u in $(inst ecm_run); do systemctl stop "$u" >/dev/null 2>&1 || true; done ;;
esac
exit 0
